# Sandbox-only image for the Base44 dev environment (see docker-compose.base44.yml).
#
# It installs dependencies ONLY. Application source is bind-mounted at runtime so
# edits are picked up by uvicorn --reload instead of being frozen into an image.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Tk shared libraries are needed because tests/test_app.py imports client.py,
# which imports tkinter. The hub itself never needs a display.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tk \
    && rm -rf /var/lib/apt/lists/*

# requirements-dev.txt pulls in requirements.txt plus pytest/httpx, so the test
# suite can run inside this container.
COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

EXPOSE 8751
